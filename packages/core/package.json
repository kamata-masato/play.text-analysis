{
  "name": "@glossa/core",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./models/*.js": {
      "types": "./distributions/models/*.d.ts",
      "default": "./distributions/models/*.js"
    },
    "./pipes/*.js": {
      "types": "./distributions/pipes/*.d.ts",
      "default": "./distributions/pipes/*.js"
    },
    "./pipelines/*.js": {
      "types": "./distributions/pipelines/*.d.ts",
      "default": "./distributions/pipelines/*.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:verify": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "@vitest/ui": "^3.2.4",
    "hast-util-sanitize": "^5.0.2",
    "vitest": "^3.0.0"
  }
}
